{
  "name": "@10x-fermenta/code-reviewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Custom GitHub Copilot SDK agent that reviews a git diff. Basic entry point for further agent integration (e.g. CI).",
  "bin": {
    "code-reviewer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "review": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
